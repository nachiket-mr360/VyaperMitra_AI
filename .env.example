# VyaparMitra — copy to backend/.env or project .env (never commit real secrets)

FLASK_ENV=development
FLASK_DEBUG=1
# Change before any shared or public deploy. Never commit a real value.
# Development only. For Docker production, set a unique random SECRET_KEY of at least 32 characters.
SECRET_KEY=dev-only-change-me
# Backend bind
HOST=127.0.0.1
PORT=5000

# SQLite path relative to backend/ or absolute.
# Docker production: DATABASE_PATH=/var/data/vyaparmitra.db (volume /var/data)
DATABASE_PATH=vyaparmitra.db

# IANA timezone for all business dates and reminders
BUSINESS_TIMEZONE=Asia/Kolkata

# Gnani Prisma STT — placeholders only. Never commit a real key.
GNANI_API_KEY=
GNANI_ENABLED=true
GNANI_PRISMA_VERSION=3.0
GNANI_TIMBRE_VERSION=3.0
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_TIMEOUT=60
GNANI_STT_MAX_BYTES=5242880
GNANI_STT_MAX_SECONDS=30
# Timbre TTS uses the same GNANI_API_KEY. Flask posts to
# https://api.vachana.ai/api/v1/tts/inference (official docs). Never expose the key to React.
# Timbre body is text/voice/model/language/audio_config only — no speed or pitch fields.
GNANI_TTS_VOICE=Lakshmi
GNANI_TTS_MODEL=timbre-v3.0
# Browser playbackRate with pitch preserved (1.0–1.25). Default ~12% faster.
TTS_PLAYBACK_RATE=1.12
INTENT_PENDING_TTL_SECONDS=900

# Temporary LLM reasoning (Flask only). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini

# CORS — Vite dev server. Docker (Flask serves the UI): http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
