# VyaparMitra — copy to backend/.env or project .env (never commit real secrets)

FLASK_ENV=development
FLASK_DEBUG=1
# Change before any shared or public deploy. Never commit a real value.
SECRET_KEY=dev-only-change-me
# Backend bind
HOST=127.0.0.1
PORT=5000

# SQLite path relative to backend/ or absolute
DATABASE_PATH=vyaparmitra.db

# IANA timezone for all business dates and reminders
BUSINESS_TIMEZONE=Asia/Kolkata

# Gnani Prisma STT — placeholders only. Never commit a real key.
GNANI_API_KEY=
GNANI_ENABLED=true
GNANI_PRISMA_VERSION=3.0
GNANI_TIMBRE_VERSION=3.0
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_TIMEOUT=60
GNANI_STT_MAX_BYTES=5242880
GNANI_STT_MAX_SECONDS=30

# CORS — Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
